@@ -9,6 +9,9 @@
 #include <filesystem>
 
 namespace xloil { class RegisteredWorksheetFunc; }
+// Declared in src/xlOil-COM/Connect.h (not a public header); a static XLL must
+// drop the COM event sink itself on unload — see autoClose below.
+namespace xloil { namespace COM { void disconnectCom(); } }
 
 namespace XllInfo
 {
@@ -55,6 +58,10 @@ namespace xloil
   {
     std::unique_ptr<T> theAddin;
     std::vector<std::shared_ptr<const RegisteredWorksheetFunc>> theFunctions;
+    // True once autoOpen initialised the message queue, so autoClose only tears
+    // down what it actually created (Excel calls xlAutoClose on paths where the
+    // add-in never opened).
+    bool theWasOpen = false;
 
     ~RegisterAddin()
     {
@@ -67,6 +74,18 @@ namespace xloil
 
     void autoOpen()
     {
+      // [EGTools++] Duplicate-load guard: when the same XLL is registered more
+      // than once (duplicate OPEN/OPEN<n> registry entries, or add-in manager
+      // plus a command-line load), Excel calls xlAutoOpen once per REGISTER on
+      // the one loaded module. Without this guard the second pass re-registers
+      // everything, then theAddin.reset(new T()) destroys the previous addin,
+      // whose destructor unregisters the just-registered functions — every UDF
+      // returns #VALUE!, the ribbon vanishes, and the torn state crashes in
+      // xlAutoClose. First open wins; later opens are no-ops (autoClose is
+      // already idempotent via theXllIsOpen/theWasOpen).
+      if (theXllIsOpen)
+        return;
+
       try
       {
         Environment::initAppContext();
@@ -81,6 +100,7 @@ namespace xloil
 
         // Do this safely in single-thread mode
         initMessageQueue(Environment::excelProcess().hInstance);
+        theWasOpen = true;
 
         lauch();
 
@@ -110,6 +130,21 @@ namespace xloil
         theAddin.reset();
 
       theFunctions.clear();
+
+      // Mirror what AddinLoader.cpp does for the xlOil.dll case: a static XLL is
+      // its own core, so nothing else tears these down. Excel FreeLibrary's the
+      // XLL after xlAutoClose, and the message queue's hidden window + the COM
+      // event sink both hold callbacks into this module — left alive they are
+      // dangling pointers (CFG fast-fail 0xC0000409) and the window class blocks
+      // a later re-tick. This MUST come after theFunctions.clear(), which still
+      // needs the message queue to unregister.
+      if (theWasOpen)
+      {
+        teardownMessageQueue();
+        COM::disconnectCom();
+        theWasOpen = false;
+      }
+
       theXllIsOpen = false;
     }
   };
